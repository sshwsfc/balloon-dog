# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 家长端 / 孩子端共用的对外访问基址（VITE_SERVER_URL）。只忽略仓库根目录这一个，
# 模板见 .env.example；换机器/换域名时各人自己填，不进仓库。
/.env

# 后端
server/uploads/
server/.env
server/dist/

# 交叉测试的中间产物（.class / 参考结果 json）—— 它们每次运行都会重新生成，
# 跟踪进来只会让 `git status` 永远显示一堆二进制改动。
android/scripts/crosstest/.work/
android/.android-home/
android/.gradle-home/
# 也有在仓库根目录跑 gradle 的（GRADLE_USER_HOME=.gradle-home），一并忽略
.gradle-home/
android/app/build/

# 孩子端安装包：构建产物，不进仓库（用 npm run android:copy-apk 刷新）
public/download/*.apk

# 端到端执行器的产物（report.json / 每个套件的日志 / 失败截图）——
# 它们是每次运行都会重新生成的，跟踪进来只会让 diff 里全是日志。
artifacts/

# 正式签名：keystore 本身与密码都不进仓库。
# 丢了它 = 已装机的孩子端无法覆盖升级（只能卸载重装，数据全丢），
# 所以务必在服务器 /opt/app/bdog/ssl/ 与自己手上各留一份备份。
android/keystore/release.keystore
android/keystore/keystore.properties

# 部署配置（服务器地址 / 私钥路径），模板见 .env.deploy.example
.env.deploy

# 生产环境变量（含密钥）
deploy/.env.prod

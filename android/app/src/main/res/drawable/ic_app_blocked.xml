<?xml version="1.0" encoding="utf-8"?>
<!--
  禁止使用：红色「禁止通行」图标（圆环 + 斜杠），供 AppBlockedActivity 使用。
  配色写死为 @color/danger_red —— 这张图只在「被拒绝」这一种语境里出现，
  不像 ic_shield / ic_lock 那样需要跟着语义换色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 圆环：半径 8.5，对外径 10、内径 7（EvenOdd 让内圆挖空成环） -->
    <path
        android:fillColor="@color/danger_red"
        android:fillType="evenOdd"
        android:pathData="M12,2a10,10 0 1,0 0.01,0zM12,5a7,7 0 1,1 -0.01,0z" />

    <!-- 斜杠：过圆心、45°，端点收在圆环中线（半径 8.5）以内，不越出图标的轮廓 -->
    <path
        android:fillColor="@color/danger_red"
        android:pathData="M16.95,5.64l1.41,1.41 -11.31,11.31 -1.41,-1.41z" />

</vector>

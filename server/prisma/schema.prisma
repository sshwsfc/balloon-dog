// 气球狗 —— PostgreSQL 数据模型
//
// 设计要点：
// 1. 所有业务数据都以 userId 为隔离边界，设备维度数据再以 deviceId 二级隔离
//    （mock 版把 device/features 做成全局单例，导致用户之间互相串数据，这里彻底修正）。
// 2. 需要设备端 Agent 真正执行的能力（锁屏、拍照、录像、同屏、读数）统一走
//    DeviceCommand 指令队列：后端只负责下发 + 收敛结果，不在 HTTP 请求里假装成功。
// 3. 枚举一律用 String + 中文注释（与 kesi saas 保持一致），避免迁移期的 enum 变更成本。
//
// 迁移：npm run db:up && npm run prisma:migrate
// 生成客户端：npm run prisma:generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户（家长）
// ============================================================

model User {
  id                  Int       @id @default(autoincrement())
  phone               String?   @unique // 手机号（验证码/密码登录）
  email               String?   @unique
  passwordHash        String // bcrypt；验证码/微信登录的账号用随机串占位
  nickname            String    @default("家长用户")
  avatar              String    @default("")
  wechatOpenid        String?   @unique // 微信网页授权 openid
  status              String    @default("active") // active 正常 | disabled 已禁用
  activeDeviceId      String? // 当前选中的设备（前端不传 deviceId 时的默认作用对象）
  // ---- 会员（见 features/membership）----
  // 档位存「账号当前实际拥有的档位」，过期不会写回 ordinary，而是由
  // resolveMembership() 按 membershipExpiresAt 惰性判定并顺手降级：
  // 依赖定时任务去清档位，只要任务停一次，过期用户就永久享受会员权限。
  membershipTier      String    @default("ordinary") // ordinary 普通 | member 会员 | super 超级会员
  membershipExpiresAt DateTime? // 到期时间；null = 从未开通或已过期
  /// 首次开通会员的时间。用于「首单优惠」判定与留存统计，过期也不清。
  membershipStartedAt DateTime?
  /// 连续包月：到期是否自动续费。用户可随时关闭，关闭后到期即降级。
  membershipAutoRenew Boolean   @default(false)
  /// 连续包月签约的档位。自动续费要按签约时的档位续，不能跟着当前档位漂。
  membershipRenewTier String?
  /// 首次支付成功时间（任何订单）。「首单立减」只认它，不认 device/订单数。
  firstPaidAt         DateTime?
  /// 累计实付金额（分）。用于「老客优惠」与运营统计，退款不回冲（退款另行记录）。
  totalPaidCents      Int       @default(0)
  // ---- 分享提成 / 邀请返现（见 features/referral）----
  /// 本人的邀请码。注册时生成；老账号（或生成失败）由 ensureInviteCode() 惰性补发。
  inviteCode          String?   @unique
  /// 邀请人。null = 自然注册（没有被谁邀请）。
  /// 用 SetNull 而不是 Cascade：邀请人注销不该把被邀请人的账号一起带走。
  referredById        Int?
  referredBy          User?     @relation("UserReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]    @relation("UserReferral")
  /// 绑定邀请关系的时刻（与 createdAt 可能不同：老账号是后补绑的）。
  referredAt          DateTime?
  /// 实名认证（提现前置条件）。只留姓名 + 身份证后 4 位 + 整串哈希：
  /// 提现要能证明「钱给对了人」，但平台没有任何理由存一份明文身份证号。
  realName            String?
  idCardHash          String?
  idCardTail          String?
  verifiedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices          ChildDevice[]
  quizRecords      QuizRecord[]
  commands         DeviceCommand[]   @relation("CommandRequester")
  media            MediaAsset[]
  membershipOrders MembershipOrder[]

  referralRewards     ReferralReward[]     @relation("RewardInviter")
  rewardsFromReferral ReferralReward[]     @relation("RewardInvitee")
  referralWithdrawals ReferralWithdrawal[]
  referralCoupons     ReferralCoupon[]
  referralsMade       Referral[]           @relation("ReferralInviter")
  referralSource      Referral?            @relation("ReferralInvitee")

  @@index([status])
  @@index([membershipTier, membershipExpiresAt])
  @@index([referredById])
}

// ============================================================
// 孩子设备
// ============================================================

model ChildDevice {
  id                   String    @id @default(cuid())
  // 可为空：设备端 Agent 先自助注册（userId 为空 = 待认领），家长再凭绑定码认领。
  // mock 版没有归属概念，任何未登录请求都能读写「全局那一台设备」，这里从模型层面就堵死。
  userId               Int?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String // 家长起的名字，如「小明的小米手机」
  model                String    @default("Unknown")
  os                   String    @default("Unknown") // Android | iOS | HarmonyOS
  osVersion            String    @default("")
  avatar               String    @default("")
  /// 隐藏孩子设备桌面上的图标（§9）。设备端按此值切换 activity-alias 的启用状态。
  /// 默认 true：桌面图标能被长按卸载，所以默认不显示；家长在「隐藏图标」卡片里可改回 false。
  hideIcon             Boolean   @default(true)
  deviceCode           String    @unique // 设备绑定码：设备端生成并展示，家长输入后完成认领
  deviceSecretHash     String // 设备端密钥的 bcrypt 哈希（设备端用于续订 device token）
  boundAt              DateTime? // 家长认领时间；null 表示尚未被任何家长绑定
  status               String    @default("offline") // online | offline
  battery              Int       @default(0)
  network              String    @default("unknown") // wifi | cellular | ethernet | unknown
  locked               Boolean   @default(false) // 家长的<b>期望</b>状态（远程锁定）
  tempUnlockUntil      DateTime? // 临时解锁到期时间（null 表示未临时解锁）
  // 设备上<b>实际</b>的锁定状态。与 locked 刻意分开：
  // 设备可能因为作息时间表或每日额度而锁定，那与家长的远程指令无关。
  // 只报期望值会让家长在「作息时间到了」时看到「未锁定」这种错误结论。
  effectiveLocked      Boolean   @default(false)
  lockReason           String    @default("") // 生效锁定原因的人话说明
  /// 应用审核批准后的「允许安装」窗口截止时间（§3）。null = 当前没有放行窗口。
  /// 家长批准某条 AppAuditRequest 时置为 now + 30 分钟，随 /agent/config 下发。
  installApprovalUntil DateTime?
  agentVersion         String    @default("")
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  features       DeviceFeature[]
  timePlan       TimePlan?
  appLimits      AppLimit[]
  appAudits      AppAuditRequest[]
  blockedUrls    BlockedUrl[]
  locations      LocationRecord[]
  safeZones      SafeZone[]
  commands       DeviceCommand[]
  quizConfig     QuizConfig?
  quizRecords    QuizRecord[]
  media          MediaAsset[]
  lockPolicy     LockPolicy?
  schedules      ScheduleRule[]
  screenConfig   ScreenMonitorConfig?
  screenBatches  ScreenBatch[]
  screenInsights ScreenInsight[]
  usageAlerts    UsageAlert[]
  usageEpisodes  UsageEpisode[]
  usageBudgets   UsageBudget[]
  screenQuiz     ScreenQuizQuestion[]
  mode           DeviceMode?
  studySlots     StudyModeSlot[]
  modeApps       ModeApp[]
  installedApps  DeviceApp[]
  eyeCare        EyeCareConfig?
  appPlugins     AppPluginState[]
  events         DeviceEvent[]
  callLogs       CallLogEntry[]
  smsMessages    SmsMessage[]

  @@index([userId])
  @@index([userId, status])
}

// ============================================================
// 功能开关（每个设备一份）
// ============================================================

model DeviceFeature {
  id        String      @id @default(cuid())
  deviceId  String
  device    ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key       String // lockScreen | tempUnlock | timePlan | appLimit | appAudit | webBlock
  //          screenMonitor | remoteHelp | callSms | remotePhoto | remoteRecord
  //          videoRecord | audioRecord | quizUnlock
  enabled   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([deviceId, key])
}

// ============================================================
// 时间规划（每日可用时长）
// ============================================================

model TimePlan {
  id                String      @id @default(cuid())
  deviceId          String      @unique
  device            ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  enabled           Boolean     @default(false)
  dailyLimitMinutes Int         @default(0) // 0 表示不限制
  usedTodayMinutes  Int         @default(0)
  resetAt           DateTime    @default(now()) // usedTodayMinutes 的归零基准日
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// ============================================================
// 应用时长限制 / 应用审核 / 网址拦截
// ============================================================

model AppLimit {
  id                String      @id @default(cuid())
  deviceId          String
  device            ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  appName           String // 展示名，如「抖音」
  packageName       String      @default("") // Android 包名 / iOS Bundle ID
  dailyLimitMinutes Int         @default(0)
  enabled           Boolean     @default(true)
  /// 今日已用秒数（§4）。设备端上报、服务端只存与展示，**不参与判定**：
  /// 真正的逐应用限时由设备端本地用上报值判定（离线也要拦得住）。
  usedTodaySeconds  Int         @default(0)
  /// usedTodaySeconds 归属的自然日（YYYY-MM-DD，服务端时区）。
  /// 与 TimePlan.resetAt 一样走「读取时惰性归零」，不依赖定时任务。
  usageDay          String      @default("")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([deviceId, appName])
}

model AppAuditRequest {
  id          String      @id @default(cuid())
  deviceId    String
  device      ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  appName     String
  packageName String      @default("")
  status      String      @default("pending") // pending 待审核 | approved 已批准 | rejected 已拒绝
  reason      String      @default("")
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([deviceId, status])
}

model BlockedUrl {
  id        String      @id @default(cuid())
  deviceId  String
  device    ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  url       String // 域名或网址
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([deviceId, url])
}

// ============================================================
// 设备指令队列（后端下发 → 设备端轮询领取 → 回报结果）
// ============================================================

model DeviceCommand {
  id              String      @id @default(cuid())
  deviceId        String
  device          ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type            String // lock | unlock | temp_unlock | cancel_temp_unlock
  //                remote_photo | screenshot | start_recording | stop_recording
  //                start_audio | stop_audio | sync_config | fetch_location
  payload         Json? // 指令参数，如 { minutes: 30 }
  status          String      @default("pending") // pending 待领取 | dispatched 已领取执行中
  //                succeeded 成功 | failed 失败 | expired 超时未领取 | cancelled 家长撤销
  result          Json? // 设备端回传的结果，如 { mediaId: "..." }
  error           String      @default("")
  requestedBy     Int?
  requestedByUser User?       @relation("CommandRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  dispatchedAt    DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([deviceId, status])
  @@index([status, expiresAt])
  @@index([deviceId, createdAt])
}

// ============================================================
// 位置轨迹与安全区
// ============================================================

model LocationRecord {
  id         String      @id @default(cuid())
  deviceId   String
  device     ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float       @default(0) // 精度（米）
  address    String      @default("")
  type       String      @default("other") // home 家 | school 学校 | other 其它
  recordedAt DateTime // 设备上报的时刻（非入库时刻）
  createdAt  DateTime    @default(now())

  @@index([deviceId, recordedAt])
}

model SafeZone {
  id           String      @id @default(cuid())
  deviceId     String
  device       ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int         @default(200)
  address      String      @default("")
  type         String      @default("other") // home | school | other
  /// 只有 enabled 的安全区才下发到设备端做围栏判定（§2）
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([deviceId])
}

// ============================================================
// 答题解锁
// ============================================================

model QuizQuestion {
  id            String   @id @default(cuid())
  type          String // english 英文单词 | poetry 古诗填空
  grade         String   @default("grade1") // grade1..grade6
  question      String
  options       String[]
  correctAnswer Int // options 的下标
  explanation   String   @default("")
  createdAt     DateTime @default(now())

  records QuizRecord[]

  @@index([type, grade])
}

model QuizConfig {
  id                   String      @id @default(cuid())
  deviceId             String      @unique
  device               ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  enabled              Boolean     @default(false)
  quizType             String      @default("english") // english | poetry | random
  grade                String      @default("grade1") // 题库年级
  correctRewardMinutes Int         @default(3) // 答对奖励时长
  randomMode           Boolean     @default(false) // 根据设备画面随机出题
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model QuizRecord {
  id            String       @id @default(cuid())
  // 可为空：答题由设备端 Agent 提交，理论上设备可能尚未被认领
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        ChildDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  type          String
  questionText  String // 冗余题干，题库删改后记录仍可读
  userAnswer    Int
  isCorrect     Boolean
  rewardMinutes Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// 锁屏强度策略（每台设备一份）
// ============================================================

/// 决定设备端「锁得住到什么程度」。设备端会结合自身实际权限自动降级，
/// 这里存的是家长的<b>期望强度</b>，实际生效强度由设备在指令结果里如实回报。
model LockPolicy {
  id       String      @id @default(cuid())
  deviceId String      @unique
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// kiosk 锁定页（默认：用 Lock Task 把设备钉在锁定页，可远程解锁）
  /// password 随机改系统锁屏密码（最高强度：连系统锁屏都进不去）
  strength String @default("kiosk")

  /// 锁屏前用透明悬浮窗预告的秒数；0 表示不预告
  countdownSeconds Int @default(30)

  /// 是否启用下方的时间表（ScheduleRule）
  scheduleEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 定时锁屏 / 定时解锁时间表
// ============================================================

/// 一条按星期重复的时段规则。
///
/// 语义（设备端 ScheduleEngine 的求值顺序）：
///   1. 命中任意一条 enabled 的 `unlock` 规则 → 此时段允许使用；
///   2. 否则命中任意一条 `lock` 规则 → 此时段锁定；
///   3. 都没命中 → 不因时间表锁定。
/// `unlock` 优先于 `lock`，这样「整晚锁定 + 中午放行」这类组合可以直接表达。
model ScheduleRule {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  name   String @default("") // 例如「晚上睡觉」，仅用于展示
  action String @default("lock") // lock 锁定 | unlock 允许使用

  /// 生效的星期：0=周日 … 6=周六（与 JS Date.getDay() 一致）
  daysOfWeek Int[]

  /// 从 00:00 起的分钟数，取值 0..1439
  startMinute Int
  /// 取值 0..1440；1440 表示当天 24:00；
  /// endMinute < startMinute 表示跨天（例如 22:00 → 次日 07:00）
  endMinute   Int

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}

// ============================================================
// 屏幕行为 AI 洞察
// ============================================================
//
// 数据流：设备端周期截屏 → 每 N 张打一个包上传 → 服务端解包落盘
//        → AI 视觉分析（可插拔 provider）→ ScreenInsight
//        → 抽取 UsageAlert（异常提醒）与 UsageEpisode（局数/集数）
//        → 按 UsageBudget 累计，超限则下发锁屏指令。
//
// 隐私约定：这里存的是<b>孩子屏幕的内容</b>，是全项目最敏感的数据。
// 默认关闭、必须家长在设备上显式授权、按 retentionDays 定时清理，
// 且家长端与管理后台都不提供原图浏览（只给结构化结论）。

/// 每台设备的截屏与分析设置。
model ScreenMonitorConfig {
  id       String      @id @default(cuid())
  deviceId String      @unique
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 是否开启周期截屏。默认关闭 —— 这是最敏感的权限，必须家长显式打开
  captureEnabled         Boolean @default(false)
  /// 截屏间隔（秒）
  captureIntervalSeconds Int     @default(30)
  /// 每攒够多少张打一个包上传
  framesPerBatch         Int     @default(10)

  /// 是否用 AI 分析收到的包
  analyzeEnabled     Boolean @default(true)
  /// 每个包最多送几张给 AI（成本控制，均匀采样）
  analyzeSampleCount Int     @default(6)
  /// 帧图留档天数，过期由定时任务清理
  retentionDays      Int     @default(7)

  /// 锁定页是否优先出「基于屏幕内容」的题
  quizFromScreen Boolean @default(false)

  // ---- 五类异常提醒开关 ----
  alertMinorContent  Boolean @default(true) // 未成年 / 不适龄内容
  alertScam          Boolean @default(true) // 疑似被骗（转账、验证码、陌生链接）
  alertEmotional     Boolean @default(true) // 情绪问题（自伤、极端言论、被欺凌）
  alertGameAddiction Boolean @default(true) // 游戏沉迷（连续多局、深夜在线）
  alertHighSpending  Boolean @default(true) // 高额消费（充值、打赏、内购）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 一次上传的图片包。分析以「包」为单位 —— 单张图既判断不准也浪费额度。
model ScreenBatch {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime

  expectedFrames Int    @default(0)
  actualFrames   Int    @default(0)
  sizeBytes      Int    @default(0)
  /// 解包后帧图所在目录（相对 MEDIA_DIR）
  storagePath    String @default("")

  /// pending 待分析 | analyzing 分析中 | done 完成 | failed 失败 | skipped 已跳过（未配置 AI）
  status     String @default("pending")
  failReason String @default("")
  provider   String @default("")
  model      String @default("")
  analysisMs Int    @default(0)

  createdAt DateTime @default(now())

  frames  ScreenFrame[]
  insight ScreenInsight?

  @@index([deviceId, startedAt])
  @@index([status, createdAt])
}

/// 包内单张帧的元数据。图片本体在磁盘上，这里只存索引信息。
model ScreenFrame {
  id      String      @id @default(cuid())
  batchId String
  batch   ScreenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  seq         Int
  capturedAt  DateTime
  /// 设备端尽力上报的前台包名（拿不到时为空）
  packageName String   @default("")
  /// 相对 MEDIA_DIR 的路径
  storagePath String   @default("")
  sizeBytes   Int      @default(0)

  @@index([batchId, seq])
}

/// AI（或降级启发式）对一个包的结论。一个包最多一条。
model ScreenInsight {
  id      String      @id @default(cuid())
  batchId String      @unique
  batch   ScreenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 给人看的总结：「这段时间在玩《王者荣耀》，进行到对局结算界面」
  summary String @default("")

  activities   Json? // [{ app, packageName, category, description, frameFrom, frameTo }]
  games        Json? // [{ name, scene, roundCompleted, confidence, evidence }]
  videos       Json? // [{ name, episodeCompleted, confidence, evidence }]
  contentFlags Json? // 五类风险的布尔 + 证据
  topics       Json? // [{ subject, term, meaning }] —— 屏幕答题的原料

  keywords String[] // 屏幕关键词（英文单词、古诗名、角色名…）

  /// none | low | medium | high
  riskLevel String @default("none")

  /// disabled（未配置 AI）| heuristic（降级推断）| openai-compatible
  provider         String @default("")
  model            String @default("")
  promptTokens     Int    @default(0)
  completionTokens Int    @default(0)

  /// 失败原因（status=failed 时）
  error   String @default("")
  /// 原始模型响应，便于排查与复算
  rawJson String @default("")

  createdAt DateTime @default(now())

  alerts   UsageAlert[]
  episodes UsageEpisode[]

  @@index([deviceId, createdAt])
  @@index([riskLevel, createdAt])
}

/// 异常提醒。由 AI 结论里的 contentFlags 生成，家长端可标记已读。
model UsageAlert {
  id        String         @id @default(cuid())
  deviceId  String
  device    ChildDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  insightId String?
  insight   ScreenInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)

  /// minor_content | scam_suspect | emotional_issue | game_addiction | high_spending
  type     String
  /// low | medium | high
  severity String @default("medium")

  title    String
  detail   String @default("")
  /// 判定依据（引用模型给出的原文），便于家长判断是不是误报
  evidence String @default("")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([deviceId, createdAt])
  @@index([deviceId, readAt])
  @@index([type, createdAt])
}

/// 可计数的用量片段：玩了第几局、看完第几集。
///
/// 刻意与 ScreenInsight 的文本总结分开：局数/集数要能被打平、按天聚合、
/// 拿来跟预算比大小，不能被一段自然语言绑死。
model UsageEpisode {
  id        String         @id @default(cuid())
  deviceId  String
  device    ChildDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  insightId String?
  insight   ScreenInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)

  /// game_round 游戏局数 | video_episode 动画集数
  kind        String
  appName     String @default("")
  packageName String @default("")
  count       Int    @default(1)
  confidence  Float  @default(0)
  evidence    String @default("")

  occurredAt DateTime
  /// 设备本地日 YYYY-MM-DD，用于「今日已玩几局」的聚合
  dayKey     String

  createdAt DateTime @default(now())

  @@index([deviceId, dayKey, kind])
}

/// 家长设的用量上限：「今天最多玩 3 局」「今天最多看 2 集」。
model UsageBudget {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// game_round | video_episode
  kind    String
  /// 应用名；留空表示对「全部应用」生效
  appName String @default("")

  dailyLimit Int
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, kind, appName])
}

/// 由屏幕内容生成的题（需求 8：看小猪佩奇就出 pig 这个单词）。
model ScreenQuizQuestion {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 产生这道题的洞察；洞察被清理后题目仍可用，故不设外键级联
  insightId String?

  grade         String
  subject       String // english | poetry | math | general
  question      String
  options       String[]
  correctAnswer Int
  explanation   String   @default("")
  /// 来自屏幕的哪个词/主题，例如 "pig"
  sourceTerm    String   @default("")

  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([deviceId, grade, usedAt])
}

// ============================================================
// 短信验证码
// ============================================================

model SmsCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String // 验证码本身也哈希存储（防日志/DB 泄露后直接可用）
  purpose    String // register 注册 | login 验证码登录 | bind 绑定手机号
  attempts   Int       @default(0) // 校验失败次数，超限作废
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

// ============================================================
// 媒体（设备回传的照片/截图/音视频）
// ============================================================

model MediaAsset {
  id        String      @id @default(cuid())
  deviceId  String
  device    ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // photo 拍照 | screenshot 屏幕截图 | video 录像 | audio 录音
  filename  String // 落盘文件名
  mimeType  String
  sizeBytes Int
  commandId String? // 由哪条指令产生
  createdAt DateTime    @default(now())

  @@index([deviceId, createdAt])
  @@index([userId])
}

// ============================================================
// 管理后台（与家长账号完全隔离：独立表、独立令牌、独立入口）
// ============================================================

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique // 登录账号
  passwordHash String // bcrypt
  name         String    @default("管理员")
  // 角色：super 超级管理员（可管理其它管理员）| operator 运营（只读 + 日常处置）
  role         String    @default("super")
  status       String    @default("active") // active 正常 | disabled 已禁用
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

/// 管理员操作审计。记录每一次 /api/admin 请求（含登录尝试），
/// 请求参数里的密码/密钥/令牌会被脱敏后再落库。
model OperationLog {
  id        Int      @id @default(autoincrement())
  adminId   Int? // 登录失败等场景可能为空
  adminName String   @default("") // 管理员账号名（登录尝试时取请求体）
  action    String // 人类可读的操作描述，如「禁用家长账号」
  method    String // HTTP 方法
  path      String // 请求路径
  status    Int // 响应状态码
  detail    String? // 脱敏后的请求参数摘要（JSON）
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

// ============================================================
// 模式切换（学习模式 / 普通模式）· 护眼 · 应用插件管控
// ============================================================
//
// 三者共用一条主线：家长在「某个时段」对「某些应用」施加「某些限制」。
// 求值一律离线优先 —— 规则原样下发到设备，Android 侧 StudyModeEngine 本地判定，
// 服务端 mode.service.ts 里有同一套逻辑只用于展示「当前模式」。
// 两边必须保持一致，由 crosscheck 脚本逐点比对（见 docs/PLAN-mode-eyecare-plugin.md）。

/// 每台设备的模式配置。
model DeviceMode {
  id       String      @id @default(cuid())
  deviceId String      @unique
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 手动指定的模式：study 学习 | normal 普通；null 表示跟随时段规划。
  manualMode      String?
  /// 是否启用「按时间设置」的时段规划。
  /// 注意：开启但一格都没选时，按约定<b>全天都是学习模式</b>（与参考产品一致），
  /// 家长端会对这个状态显示红色警告。
  scheduleEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 学习模式的时段格子：0–23 时 × 星期。命中即为学习模式，未命中为普通模式。
model StudyModeSlot {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// 0=周日 … 6=周六（与 JS Date.getDay()、ScheduleRule.daysOfWeek 一致）
  dayOfWeek Int
  /// 0..23
  hour      Int

  createdAt DateTime @default(now())

  @@unique([deviceId, dayOfWeek, hour])
  @@index([deviceId])
}

/// 学习模式下的应用分组。
model ModeApp {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  packageName String
  appName     String @default("")
  /// study  = 学习模式允许使用（白名单）
  /// normal = 普通模式专用（学习模式下会被拦）
  /// 既不在任何一组的应用，学习模式下<b>默认被拦</b>（更安全的一侧）。
  group       String @default("study")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, packageName, group])
  @@index([deviceId])
}

/// 设备上报的已安装应用清单（全量替换），是「选择应用」「插件管理」的数据来源。
model DeviceApp {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  packageName  String
  appName      String  @default("")
  /// 系统应用默认不在家长端展示（清单里仍保留，便于排查）
  isSystem     Boolean @default(false)
  /// 普通应用（可启动、有桌面图标）—— 只有这些才值得管控
  isLaunchable Boolean @default(true)

  /// 应用图标（孩子端从 PackageManager 抓取后压缩成的 PNG 原始字节）。
  ///
  /// 为什么放数据库而不是磁盘：图标只有几 KB，跟着 DeviceApp 一起级联删除，
  /// 解绑设备时不会留下孤儿文件；也不需要再维护一套存储目录。
  /// 为什么不在列表接口里内联返回：一次列表最多 500 条，内联会让响应涨到几百 KB，
  /// 而图标几乎不变 —— 用 /api/device-apps/:id/icon 单独取，让浏览器长期缓存。
  icon     Bytes?
  /// 图标 MIME，目前固定 image/png
  iconMime String?
  /// 图标内容 sha256（前 16 位），既做缓存失效参数，也用来判断要不要重传
  iconHash String?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([deviceId, packageName])
  @@index([deviceId])
}

/// 护眼设置。
model EyeCareConfig {
  id       String      @id @default(cuid())
  deviceId String      @unique
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  /// 连续用眼多少分钟后提醒休息
  continuousMinutes Int @default(40)
  /// 休息时长（分钟）。期间锁定屏幕，休息结束自动解锁。
  restMinutes       Int @default(10)

  /// 夜间护眼时段的起止小时（0..23）。两者相等表示不启用夜间时段。
  nightStartHour   Int     @default(22)
  nightEndHour     Int     @default(7)
  /// 夜间是否直接锁定（false 则只在设备上提示，不锁）
  nightLockEnabled Boolean @default(false)

  /// 屏幕亮度上限（百分比 10..100）；0 表示不限制
  maxBrightnessPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 微信 / QQ 等功能管控的单条状态。
///
/// 目录（有哪些插件、匹配什么关键词）定义在代码里而不是表里：
/// 它是<b>版本化的产品知识</b>，随应用改版调整，不适合让家长误改。
/// 这里只存「家长把它开成什么」。
model AppPluginState {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  packageName String
  pluginKey   String
  /// true = 允许使用，false = 拦截
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, packageName, pluginKey])
  @@index([deviceId])
}

/// 设备事件流，供家长端「最新动态」展示。
///
/// 与 ScreenInsight 的分工：那个是「屏幕内容分析」，这个是**轻量的状态与动作事件**，
/// 不需要截屏也不需要 AI，因此可以高频上报且长期保留（仍受清理策略约束）。
model DeviceEvent {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// unlock | lock | screen_on | screen_off | app_installed | app_removed
  /// | mode_enter | eye_rest | plugin_blocked | app_blocked
  type   String
  /// 人话说明，家长端直接展示
  detail String @default("")

  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([createdAt])
}

// ============================================================
// 电话与短信（§8）
// ============================================================

/// 通话记录。
///
/// 只存设备端上报的摘要，**永不向管理后台返回内容**（管理后台只给计数）。
/// 「全量替换最近 N 条」的上报模型：设备端每次上报它看到的最近若干条，
/// 服务端按 occurredAt 倒序截断后整表替换这台设备的数据，
/// 这样删除/去重都不需要逐条 diff。
model CallLogEntry {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  phoneNumber     String // 归一化后的号码（保留原始字符，只去空白）
  name            String   @default("") // 通讯录里显示的名字，取不到就是空
  type            String // incoming 呼入 | outgoing 呼出 | missed 未接
  durationSeconds Int      @default(0)
  /// 通话发生时刻（设备端时间）。设备时钟可能不准，服务端只钳制「未来时间」。
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  @@index([deviceId, occurredAt])
}

/// 短信。
///
/// 与 SmsCode（登录验证码）完全是两回事：那是「发给家长登录用」的验证码，
/// 这是「孩子设备上收到的短信」。同样不对管理后台暴露内容。
model SmsMessage {
  id       String      @id @default(cuid())
  deviceId String
  device   ChildDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  address    String // 对方号码
  body       String // 短信正文
  type       String // inbox 收件 | sent 发件
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([deviceId, occurredAt])
}

// ============================================================
// 会员
// ============================================================

/// 会员套餐（家长端「成为会员」页展示的每一个可购项）。
///
/// 家长端的档位只有三档：ordinary（普通，不售卖）/ member / super，
/// 但「会员」与「超级会员」各自又有按月/按年/连续包月三种买法，
/// 所以套餐是 (tier × period) 的笛卡尔积，共 6 个 —— 用 code 唯一标识而不是用 id，
/// 因为 code 要写进订单、写进埋点，值得稳定且可读。
model MembershipPlan {
  id             String   @id @default(cuid())
  code           String   @unique // member_monthly | member_yearly | member_auto_monthly | super_*
  tier           String // member | super
  period         String // monthly 按月 | yearly 按年 | auto_monthly 连续包月
  name           String // 「会员 · 按月」
  description    String   @default("")
  /// 基准价（分）。页面上显示的「原价」就是它，动态定价规则在它基础上减。
  /// 用整数分而不是浮点元：金额算错一次就是资损，浮点 0.1+0.2 的坑不值得踩。
  basePriceCents Int
  /// 折算月数（月付 1 / 年付 12 / 连续包月 1），用来算「折合每月多少钱」。
  months         Int      @default(1)
  /// 是否在家长端标「推荐」角标。
  recommended    Boolean  @default(false)
  sortOrder      Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// 动态定价规则（后台可管理）。
///
/// 家长端每个套餐的最终价格 = 套餐基准价 → 依次套用命中的规则 → 取整。
/// 规则只描述「什么条件下减多少」，具体命中哪几条由 pricing.ts 的引擎决定：
/// 不可叠加的规则按 priority 只取一条，可叠加的全部生效，最后兜底不低于 1 分。
model MembershipPricingRule {
  id                  String   @id @default(cuid())
  name                String // 「首单立减 20 元」
  /// 触发条件。取值见 membership.constants.ts 的 RULE_CONDITIONS：
  /// first_purchase 从未付费 | active_membership 会员续费 | no_active_membership 未开通/已过期
  /// | device_count 绑定设备数 ≥ N | registered_within_days 注册 ≤ N 天 | tier_upgrade 由低档升级
  conditionType       String
  /// conditionType 的参数（不用的留空）。用独立列而不是 JSON 字符串：
  /// 后台要按这些字段做表单校验，JSON 里的错字只能等到运行期才炸。
  conditionMinDevices Int?
  conditionDays       Int?
  conditionFromTier   String? // tier_upgrade 专用：来源档位
  /// 作用范围。all 表示不限；targetTier 与 targetPeriod 同时匹配才生效。
  targetTier          String   @default("all") // all | member | super
  targetPeriod        String   @default("all") // all | monthly | yearly | auto_monthly
  /// 优惠方式：percent 按比例减 | amount 直接减固定金额
  discountType        String // percent | amount
  /// percent: 1-100 的百分比；amount: 分
  discountValue       Int
  /// 可否与其他规则叠加。false 时同一订单只取优先级最高的一条（避免「满减叠满减」变成 1 分钱）。
  stackable           Boolean  @default(false)
  /// 优先级，越大越先算。不可叠加的规则之间只留最高优先级那条。
  priority            Int      @default(0)
  enabled             Boolean  @default(true)
  /// 结算明细里给家长看的一句话；留空则由服务端按 discountType 自动生成。
  note                String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([enabled, priority])
}

/// 受邀用户定价规则（后台可管理）—— 会员价格与「买家是不是被邀请来的」的关联公式。
///
/// 结账价格 = max(常规定价, 受邀价)：
///  - 常规定价 = 套餐基准价 − MembershipPricingRule 命中的规则（见 pricing.ts）；
///  - 受邀价 = 本表**每条**命中的规则各算一个价（percent/amount/fixed），取其中最高的；
///  - 被邀请注册的家长价格**更高**：邀请人要拿的分享返现是平台出的，成本落在这张订单上。
///
/// 命中前提：账号是被邀请注册的（`User.referredById` 非空）。本表只描述「受邀价怎么算」，
/// 「算不算受邀用户」由账号自己的数据决定 —— 定价引擎仍然是纯函数，试算与线上必然一致。
///
/// 取 max 还有一个安全上的理由：后台把规则配错（比例填 0、一口价填得比常规价还低）
/// 只会「不生效」，绝不会出现「被邀请反而更便宜」的套利口子 —— 那是能被直接刷的漏洞。
model MembershipReferralPriceRule {
  id                    String   @id @default(cuid())
  name                  String // 「受邀好友首单上浮 50%」
  /// 作用范围。all 表示不限；targetTier 与 targetPeriod 同时匹配才参与比价。
  targetTier            String   @default("all") // all | member | super
  targetPeriod          String   @default("all") // all | monthly | yearly | auto_monthly
  /// 上浮方式：percent 按常规定价实付上浮 | amount 加收固定金额 | fixed 一口价
  priceType             String // percent | amount | fixed
  /// percent: 上浮百分比（在常规定价**实付价**基础上 ×(100+v)/100）；
  /// amount: 加收多少分；fixed: 一口价（分），低于常规定价时不生效。
  /// 不管哪种方式，最终都不会低于 MIN_PAYABLE_CENTS（1 元）。
  priceValue            Int
  /// 只在被邀请人**首单**生效。专享价的目的就是推动首充（邀请人也是靠首充拿返现），
  /// 默认开；关掉则续费也享受专享价。
  firstPurchaseOnly     Boolean  @default(true)
  /// 邀请关系必须存在且**未作废**（Referral.status ≠ invalid，即没被反作弊判为自买自返）。
  /// 关掉则任何被邀请注册过的账号都享受，包括已被作废的。
  requireActiveReferral Boolean  @default(true)
  /// 优先级只影响**展示**（并列同价时优先显示谁）与后台排序：
  /// 价格本身是「所有命中规则各算一次再取 max」，不靠优先级挑。
  priority              Int      @default(0)
  enabled               Boolean  @default(true)
  /// 结算明细里给家长看的一句话；留空则由服务端按 priceType 自动生成。
  note                  String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([enabled, priority])
}

/// 会员订单。
///
/// 金额与命中的规则都在下单时**快照**下来：规则是可以后台随时改的，
/// 若订单只存 planCode，事后对账就会用今天的价格去解释上个月的订单。
model MembershipOrder {
  id      String @id @default(cuid())
  /// 对外的订单号（家长端展示、客服查询用），与内部 id 分开。
  orderNo String @unique
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planCode String
  tier     String // member | super
  period   String // monthly | yearly | auto_monthly

  originalCents          Int // 下单时套餐的基准价
  amountCents            Int // 实付金额（规则算完之后，再扣掉优惠券）
  /// 命中的规则快照，JSON 字符串：[{ ruleId, name, discountType, discountValue, amountCents }]
  adjustments            String  @default("[]")
  /// 本单使用的邀请返现优惠券（见 features/referral）。规则折扣之后再抵扣，
  /// 券的金额同样要快照 —— 券用掉之后记录会被置为 used，金额只能从这里回溯。
  couponId               String?
  couponCents            Int     @default(0)
  /// 本单生效的「受邀用户定价」规则快照。与常规定价规则一样必须冻结：
  /// 规则改一次，上个月的订单就解释不清了。没命中时留空。
  referralRuleId         String?
  referralRuleName       String  @default("")
  /// 受邀用户定价比常规定价**多收**了多少分（取 max 的结果）。0 表示这单不是受邀订单，
  /// 或者命中的规则都没能超过常规定价。
  referralSurchargeCents Int     @default(0)

  payChannel    String // alipay | wechat
  /// pending 待支付 | paid 已支付 | failed 支付失败 | cancelled 已取消 | refunded 已退款
  status        String    @default("pending")
  /// 支付渠道流水号（mock 支付页生成）。
  transactionId String?
  paidAt        DateTime?
  /// 本单带来的会员生效区间（支付成功时写入）。
  startsAt      DateTime?
  expiresAt     DateTime?
  /// 是否开通了连续包月（决定到期后是否自动续费）。
  autoRenew     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([tier, createdAt])
}

// ============================================================
// 分享提成 / 邀请返现（见 features/referral）
// ============================================================

/// 活动配置（单行表，id 固定为 "default"）。
///
/// 放在库里而不是写死在 constants：截图里的「50% / 40% / 20%」「75 元上限」
/// 「次月 10-15 日发放」都是运营口径，活动一改就要发版是不可接受的。
/// 阶梯比例与券里程碑是「一张表」而不是「一个数字」，所以另开两章表：
/// ReferralRewardTier / ReferralCouponRule（后台要按行增删改，不是整段 JSON）。
model ReferralConfig {
  id      String  @id @default("default")
  enabled Boolean @default(true)

  title     String    @default("邀请新用户，返现 50%")
  subtitle  String    @default("新用户注册充值后，您最高可获得 50% 返现")
  /// 活动说明（家长端「邀请奖励说明」逐条渲染，一行一条）。
  notice    String    @default("")
  startedAt DateTime  @default(now())
  endsAt    DateTime?

  /// 月卡/季卡的最低返现比例（%）。截图规则：「月卡、季卡返现 50%」——
  /// 是**下限**而不是固定值：邀请人数价阶梯更高时按阶梯算，家长不会因为
  /// 买的是月卡反而比年卡拿得少。
  shortPeriodMinRatePercent Int @default(50)
  /// 年卡及以上的单笔返现上限（分）。截图规则：「年卡以上最高返现 75 元」。
  longPeriodCapCents        Int @default(7500)

  /// 续费返现比例（%）。截图规则：「20% 到 50%」。
  renewalRatePercent Int @default(20)
  /// 续费单笔上限（分）。截图规则：「单个邀请人奖励上限为 75 元」。
  renewalCapCents    Int @default(7500)

  /// 提现门槛（截图第 6 条）：至少 N 名有效充值用户 + 实名认证 + 累计返现 ≥ M 分。
  withdrawMinInvitees     Int     @default(3)
  withdrawMinCents        Int     @default(5000)
  withdrawRequireVerified Boolean @default(true)

  /// 发放窗口：奖励按当月统计，次月 [settleDayStart, settleDayEnd] 日发放。
  settleDayStart Int @default(10)
  settleDayEnd   Int @default(15)

  updatedAt DateTime @updatedAt
}

/// 首充返现的「邀请人数 → 返现比例」阶梯（截图第 2 条）。
/// maxInvitees 为 null 表示开区间（≥ minInvitees 全按这条）。
model ReferralRewardTier {
  id          String   @id @default(cuid())
  minInvitees Int
  maxInvitees Int?
  /// 返现比例（%）。注意截图里是「人越多比例越低」（50/40/20），不是笔误。
  ratePercent Int
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// 优惠券里程碑（截图第 4 条）：邀请满 inviteeCount 人送 amountCents 券。
/// repeatEvery 不为空表示可以重复达成：「超过 30 人每 30 人 100 元」
/// = inviteeCount 30 + repeatEvery 30（30/60/90… 各一张）。
model ReferralCouponRule {
  id           String   @id @default(cuid())
  name         String
  inviteeCount Int
  repeatEvery  Int?
  amountCents  Int
  /// 券有效期（天）。0 = 不过期。
  validDays    Int      @default(90)
  sortOrder    Int      @default(0)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// 邀请关系。一个被邀请人只会有一条（inviteeId @unique）。
model Referral {
  id            String    @id @default(cuid())
  inviterId     Int
  inviter       User      @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId     Int       @unique
  invitee       User      @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  /// 绑定用的邀请码（留档：家长可能换了码来投诉）。
  code          String
  /// bound 已绑定（还没充值）| valid 有效邀请（已充值且未退款）| invalid 已作废
  status        String    @default("bound")
  invalidReason String    @default("")
  boundAt       DateTime  @default(now())
  /// 首次有效充值的时间；提现门槛「至少 3 名有效充值用户」按它计数。
  validAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([inviterId, status])
}

/// 返现记录。
model ReferralReward {
  id        String @id @default(cuid())
  rewardNo  String @unique
  inviterId Int
  inviter   User   @relation("RewardInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId Int
  invitee   User   @relation("RewardInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  /// 产生返现的会员订单号。
  orderNo String
  /// first_purchase 首充返现 | renewal 续费返现
  kind    String

  /// 计费基数（订单实付金额，分）与最终返现额。两个都存：
  /// 比例一改，只存金额就再也解释不清这笔钱是怎么算出来的。
  baseAmountCents Int
  ratePercent     Int
  amountCents     Int
  /// 是否触发了上限（年卡 75 元 / 续费 75 元），家长端要提示「已达单笔上限」。
  capApplied      Boolean @default(false)

  /// pending 待发放（当月累计）| settled 已发放（可提现）| cancelled 已取消（退款或作弊追回）
  status       String    @default("pending")
  /// 归属月份 YYYY-MM（按当月统计的依据）。
  settleMonth  String
  settledAt    DateTime?
  cancelReason String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inviterId, status])
  @@index([inviterId, settleMonth])
  @@index([orderNo])
  @@index([status, settleMonth])
}

/// 提现申请。
model ReferralWithdrawal {
  id          String @id @default(cuid())
  withdrawNo  String @unique
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int

  /// pending 待审核 | approved 审核通过（打款中）| paid 已打款 | rejected 已驳回
  status     String @default("pending")
  /// 提现时的实名信息快照（账号后来改了实名也不影响这笔的历史记录）。
  realName   String
  idCardTail String
  /// alipay | wechat | bank
  channel    String
  /// 收款账号（脱敏存储，如 138****8000）。
  account    String

  userNote   String    @default("")
  reviewNote String    @default("")
  reviewedBy Int?
  reviewedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

/// 邀请返现优惠券（截图第 4 条），可用于购买会员时抵扣。
model ReferralCoupon {
  id          String    @id @default(cuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  /// 来源：milestone 里程碑奖励
  source      String    @default("milestone")
  /// 来源标识（里程碑的规则 id + 第几轮，如 "cuid#2"），用来保证同一里程碑只发一次。
  /// **唯一性必须带上 userId**：规则 id 是全平台共用的，只对 sourceRef 建唯一索引
  /// 会让「满 3 人发 5 元券」这个里程碑全平台只发得出第一张券。
  sourceRef   String
  /// unused 未使用 | used 已使用 | expired 已过期
  status      String    @default("unused")
  expiresAt   DateTime?
  usedAt      DateTime?
  usedOrderNo String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, sourceRef])
  @@index([userId, status])
  @@index([status, expiresAt])
}

# 生产环境变量模板 —— 复制为 deploy/.env.prod 后填真实值（deploy/.env.prod 已被 gitignore）
#
# 这个文件会被部署脚本上传到服务器 /opt/app/bdog/.env.prod（chmod 600），
# 由 docker compose 的 env_file 注入 bdog-server 容器。改完需要重新部署才会生效。
#
# 密钥怎么填：
#   - 单行字符串（密码、ID、序列号）：直接写
#   - PEM 私钥/公钥：把换行写成字面量 \n（保持一行），服务端读到后自行还原
#   - 生成随机串：openssl rand -base64 36 | tr -d '\n'

NODE_ENV=production
PORT=4000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ── 数据库（bdog-postgres 容器，不发布宿主端口）──
# POSTGRES_PASSWORD 要与 DATABASE_URL 里的密码一致，改一个就得改两处
POSTGRES_USER=balloon
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=balloon_dog
DATABASE_URL=postgresql://balloon:__CHANGE_ME__@bdog-postgres:5432/balloon_dog?schema=public

# ── 认证 ──
JWT_SECRET=__CHANGE_ME_openssl_rand_base64_36__
ACCESS_TOKEN_TTL=7d
DEVICE_TOKEN_TTL=365d
ADMIN_TOKEN_TTL=12h

# ── 对外地址（前端、二维码、微信回调都从这里来）──
PUBLIC_BASE_URL=https://__DOMAIN__
CLIENT_URL=https://__DOMAIN__
CORS_ORIGIN=https://__DOMAIN__
WECHAT_TEMPLATE_LINK_BASE=https://__DOMAIN__

# ── 限流（生产比本地严格；e2e:responsive 的爆发流量要临时抬高，见 docs/PLAN-deploy.md）──
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=60
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# ── 媒体（容器内路径，宿主对应 /opt/app/bdog/uploads）──
MEDIA_DIR=/app/uploads
MEDIA_MAX_SIZE_MB=10
MEDIA_URL_TTL_SECONDS=600
SCREEN_BATCH_MAX_SIZE_MB=8

# ── 会员 / 支付 ──
MEMBERSHIP_MOCK_PAY=false
PAYMENT_FAKE_PROVIDER=false
PAYMENT_REFUND_WINDOW_DAYS=7

# 微信支付 v3
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
# 验签材料二选一：平台证书 WECHAT_PAY_PLATFORM_CERT 或 微信支付公钥 WECHAT_PAY_PLATFORM_PUBLIC_KEY。
# 公钥模式还要填 PUBLIC_KEY_ID（形如 PUB_KEY_ID_...），通知头 wechatpay-serial 的值就是它。
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://__DOMAIN__/api/payments/notify/wechat

# 支付宝（wap 支付，RSA2）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://__DOMAIN__/api/payments/notify/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 服务商代调用令牌（第三方应用才有）：商户扫码授权后拿到的那串 app_auth_token。
# 自研应用留空；填了会随每个 alipay.trade.* 请求一起带上。
ALIPAY_APP_AUTH_TOKEN=

# ── 微信登录（公众号网页授权）──
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_REDIRECT_URI=https://__DOMAIN__/api/auth/wechat/callback

# ── 腾讯云短信（验证码登录；缺任何一项都视为未配置，接口如实报错）──
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=
SMS_REGION=

# ── AI 视觉分析（未配置时批次标 skipped，家长端如实显示「未配置 AI」）──
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=
AI_HEURISTIC_FALLBACK=true

# ============================================================
# 气球狗后端环境变量
# 复制为 .env 后按需修改。所有变量在进程启动时经 zod 校验，缺失/非法会直接崩溃（fail-fast）。
# ============================================================

# ---- 基础 ----
NODE_ENV=development
PORT=4000

# ---- 数据库（对应 docker-compose.yml，注意端口是 5433）----
DATABASE_URL="postgresql://balloon:balloon_dev_pwd@localhost:5433/balloon_dog?schema=public"

# ---- 认证 ----
# 生产环境必须换成足够随机的长字符串，否则启动即报错
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# 家长端访问令牌有效期
ACCESS_TOKEN_TTL=7d
# 设备端（孩子手机上的 Agent）访问令牌有效期
DEVICE_TOKEN_TTL=365d
# 管理后台访问令牌有效期（后台会话更短，减少泄露窗口）
ADMIN_TOKEN_TTL=12h

# ---- CORS / 前端地址 ----
# 家长端有两个端口（见 vite.config.ts）：对外站点 2727（vite preview）、本机开发 5173
# （vite dev）。多个来源用英文逗号分隔；部署时把反代域名加进来，否则浏览器会因 CORS 拦掉请求。
CORS_ORIGIN=http://localhost:2727,http://127.0.0.1:2727,http://localhost:5173,http://127.0.0.1:5173
# 登录/短信回跳等用户可见的链接基址，用对外那个（部署时改成反代域名）。
CLIENT_URL=http://localhost:2727

# ---- 限流 ----
# 注意：这个配额按 IP 算。`npm run e2e:responsive` 会跑 5 档视口 × 24 路由，且每一跳都是
# 整页重载（每次都重新拉一遍 /api/user/info 等项目接口），实测峰值 300+ 请求/分钟，
# 正好压在这条线上。被限流后前端会拿不到登录态、弹回 /login，e2e 就会报成
# 「页面上找不到「xxx」」这种和限流毫无关系的假失败。
# 所以要跑响应式 e2e，本地把这里放宽（例如 3000）；生产按实际容量设回去。
RATE_LIMIT_MAX=300
# 认证类接口（登录/发码）单独的更严格限流
AUTH_RATE_LIMIT_MAX=30
# 后台登录失败尝试的每分钟上限（成功登录不计入配额）
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# ---- 短信验证码（腾讯云短信；配置齐全走真实通道，缺失时非生产回退 mock）----
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=10
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=
SMS_REGION=ap-beijing

# ---- 微信登录（公众号网页授权 / 开放平台网站应用；未配置时非生产提供 mock 扫码）----
# 同一套公众号凭证还用于「家长端绑定码扫一扫」（前端在微信内会调 wx.scanQRCode）。
# 要用扫一扫，除了填下面三项，还必须在公众号后台把家长端的访问域名加进
# 「设置与开发 → 公众号设置 → 功能设置 → JS接口安全域名」，否则 wx.config 会报
# invalid signature / invalid url domain，前端会自动退回页面内摄像头扫码。
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
# 微信授权回调地址；留空则用 PUBLIC_BASE_URL + /api/auth/wechat/callback
WECHAT_LOGIN_REDIRECT_URI=

# ---- 微信服务号模板消息（家长端「推到微信」，规划 §2.1 第二档）----
# 上面三项 + 这一项齐了，`GET /api/notifications/preferences` 的 channels.wechat 才回
# configured: true，通知设置页才会出现逐类微信开关；家长还需用微信扫码登录过一次
# （User.wechatOpenid 有值）才算绑定。没配好时投递记录停在 pending 而不是 failed ——
# 配好之后同一条会照发，不会因为当时没配就丢掉。
# 模板内容在公众号后台维护（与代码里的站内文案是两套，微信消息本身是中文的）。
WECHAT_TEMPLATE_ID=
# 微信 API 基址。只用于本地对着假上游联调：`node server/scripts/mock-wechat-server.mjs`
# （默认 :4100，与 server:mock:ai 同端口，别一起跑；用 MOCK_WECHAT_PORT 改开）。
# 生产留空即走 https://api.weixin.qq.com。
WECHAT_API_BASE_URL=
# 模板消息里跳转链接的基址；留空用 CLIENT_URL。
WECHAT_TEMPLATE_LINK_BASE=

# ---- 对外基址（用于拼接微信回调地址与媒体绝对 URL）----
# 与家长端仓库根目录 .env 里的 VITE_SERVER_URL 应该是同一个域名：
# 前者决定后端签出来的媒体/回调地址，后者决定家长端页面与安装包二维码。
# 两处不一致会出现「页面能开、图片 404」这类问题。本地开发可留空。
PUBLIC_BASE_URL=

# ---- 媒体文件（孩子设备回传的照片/截图）----
MEDIA_DIR=uploads
MEDIA_MAX_SIZE_MB=10
# 媒体签名 URL 的有效期（秒）。媒体接口不靠 Authorization 头（<img> 带不了），
# 而是由后端签发短时效 token 拼在 URL 上。
MEDIA_URL_TTL_SECONDS=600

# ---- 设备指令队列 ----
# 指令下发后多久未被设备领取即视为过期（秒）
COMMAND_TTL_SECONDS=300
# 指令过期清理任务的执行间隔（毫秒）
COMMAND_SWEEP_INTERVAL_MS=60000

# ---- 日志 ----
# 生产环境强制 info，开发环境 debug；设置后覆盖
LOG_LEVEL=

# ---- 屏幕行为 AI 洞察 ----
# 设备端上传的截屏包（10 张低分辨率 JPEG 的 zip）大小上限
SCREEN_BATCH_MAX_SIZE_MB=8
SCREEN_BATCH_MAX_FRAMES=30
SCREEN_FRAME_RETENTION_DAYS=7

# AI 视觉分析。任何 OpenAI 兼容的 /v1 都可以：
#   DeepSeek        https://api.deepseek.com/v1
#   DashScope 兼容   https://dashscope.aliyuncs.com/compatible-mode/v1  (qwen-vl-max)
#   智谱 GLM-4V      https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama      http://127.0.0.1:11434/v1
# 不配置 AI_API_KEY 时不会伪造分析结果：批次标记为 skipped，家长端明确显示「未配置 AI」。
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_FRAMES_PER_BATCH=6
# 未配置 AI 时是否启用启发式降级（明确标注「非 AI」）。开着它链路才能被完整验证。
AI_HEURISTIC_FALLBACK=true

# ── 支付渠道（规划 §5.4）─────────────────────────────────────────────
# 这一组全是**空的配置位**：没填时家长端会如实显示「支付渠道未配置」并列出缺哪几个变量，
# 而不是给一个点了没反应的按钮。订单、会员生效、退款、发票的逻辑与渠道无关，
# 换渠道只影响 features/payments/payments.provider.ts 里的签名与报文。
# 回调地址形如 https://<域名>/api/payments/notify/wechat（必须公网 https 可达）。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
# 平台证书用于**校验回调签名**。没有它就等于任何人都能伪造「已支付」回调，
# 所以宁可让回调 503，也不放过未验签的通知。
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 仅测试用的假渠道（不联网、回调签名取 md5）。生产环境下会被硬拒。
PAYMENT_FAKE_PROVIDER=false
# 家长自助退款的窗口（天），超过走客服；后台人工退款不受此限。
PAYMENT_REFUND_WINDOW_DAYS=7

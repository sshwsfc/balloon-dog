<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 网络 ================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ================= 远程采集能力 ================= -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ================= 前台服务 =================
         采集类能力必须在「带对应类型的前台服务」里执行，否则 Android 11+ 会拒绝
         后台访问相机/麦克风，Android 14 还会因为缺少 FOREGROUND_SERVICE_* 权限而崩溃。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 13+ 通知权限：拿不到的话前台服务通知不显示，服务容易被系统回收 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      作息时间表的边界唤醒（例如 22:00 必须锁屏）。
      深度 Doze 下 1 秒 ticker 会停摆，需要闹钟把判定叫醒。
      SCHEDULE_EXACT_ALARM 在 Android 12+ 需要用户授权，拿不到会退化为不精确闹钟；
      USE_EXACT_ALARM 面向闹钟/日历类应用自动授予，本应用作为管控代理同样需要准点执行。
    -->
    <!--
      枚举已安装应用。

      Android 11（API 30）起有「软件包可见性」限制：不加这个权限，
      queryIntentActivities / getInstalledApplications 只会返回极少数包
      （实测只拿到 1 个），于是「选择应用」「功能管控」列表几乎是空的，
      而且学习模式的拦截判据 AppInventory.isLaunchable() 会一律为 false ——
      拦截**静默失效**，家长设了却完全不起作用，是最难查的那种失败。

      ⚠️ 这是敏感权限，Google Play 需要说明用途（本工程是家长管控类应用，
      用途正当且必要）。若上架时被拒，退路是改用 <queries> 显式声明要管的应用，
      代价是「选择应用」只能看到声明过的那些。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 「在其他应用上层显示」：Android 10+ 后台弹出锁定页需要它 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 引导家长把本应用加入电池优化白名单，否则长轮询会被系统冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      逐应用限时（PLAN-agent-gaps §4）：读取每个应用的前台使用时长。

      这个权限从 Android 5.0 起就不走运行时弹窗，只能在
      「设置 → 特殊应用权限 → 使用情况访问」里手动打开。
      因此 AppUsageTracker.hasPermission() 用 AppOpsManager 判断，
      没拿到就如实记日志并跳过超额判定 —— 绝不假装已经能拦住。
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      通话记录与短信上报（PLAN-agent-gaps §8）。

      ⚠️ READ_CALL_LOG / READ_SMS 是 Google Play 的「受限权限」：
      上架必须单独申报用途并接受审核（Android 10+ 对通话记录的审核更严）。
      未授予时 CallLogReader / SmsReader 会跳过并记日志，不上报空数据。
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- 设备能力都是可选的：没有摄像头的设备仍可做锁屏与定位 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".AgentApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BalloonDog"
        tools:targetApi="34">

        <!-- ================= 界面 ================= -->
        <!--
          桌面入口单独做成 activity-alias（PLAN-agent-gaps §9）：

          「隐藏图标」的开关切换的是这个 alias 的启用状态（IconHider），
          而 MainActivity 本体始终保留。反过来做（直接禁用 MainActivity）
          会把锁定页跳转与家长端远程启动一起打死 —— 藏得连自己都进不去。

          隐藏后设备本机没有任何入口，只能靠 adb 或家长端远程恢复，
          这一点在设置页与家长端都有明确提示。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".MainActivityLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.QuizActivity"
            android:exported="false"
            android:label="@string/title_quiz"
            android:windowSoftInputMode="adjustResize" />

        <!-- 锁定遮罩：独立任务栈 + 不进最近任务，避免孩子通过多任务切走 -->
        <!--
          锁定页。lockTaskMode="if_whitelisted"：本应用被设为设备所有者并加入
          Lock Task 白名单后，这个页面一进入前台就自动进入 kiosk，
          不需要依赖 startLockTask() 的调用时机。未加入白名单时该属性无副作用。
        -->
        <activity
            android:name=".ui.LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:lockTaskMode="if_whitelisted"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BalloonDog.Lock" />

        <!-- 应急解锁：从全屏锁定悬浮窗打开（悬浮窗弹不出自己的 AlertDialog） -->
        <activity
            android:name=".ui.EmergencyUnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/action_emergency_unlock"
            android:theme="@style/Theme.BalloonDog.Lock"
            android:windowSoftInputMode="adjustResize" />

        <!-- 屏幕共享授权：透明、一次性 -->
        <activity
            android:name=".capability.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.BalloonDog.Transparent" />

        <!-- ================= 服务 ================= -->
        <service
            android:name=".service.AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync|camera|microphone|location" />

        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          网址拦截（PLAN-agent-gaps §5）。

          BIND_VPN_SERVICE 是系统要求：只有系统能在用户于
          VpnService.prepare() 的系统弹窗里点「确定」之后绑定它。
          exported 必须为 true 才能被系统绑定，但受权限保护，普通应用绑不上。

          它是一个前台服务（通知栏会写明「网址拦截已开启」），
          因为 VPN 断开或进程被杀都会让孩子以为「网断了」。
        -->
        <service
            android:name=".service.DnsFilterVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- ================= 广播接收器 ================= -->
        <receiver
            android:name=".capability.AgentAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                  用户解锁前就要收到：password 最高强度档随机改写了系统锁屏密码，
                  如果等到解锁后才清，而解锁又需要那个随机密码 —— 就是一个死循环，
                  设备会永久卡在系统锁屏上。directBootAware + LOCKED_BOOT_COMPLETED
                  是唯一能打破它的时机（见 android/README.md §2.4）。
                -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          保活看门狗。只接受显式广播（PendingIntent 里指定了组件），
          因此 exported=false 即可，不需要 intent-filter。
        -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          无障碍看门狗。BIND_ACCESSIBILITY_SERVICE 权限是系统要求：
          只有系统能绑定它，普通应用绑不上。
        -->
        <service
            android:name=".service.LockWatchdogService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_watchdog" />
        </service>

        <!-- JobScheduler 兜底保活；必须带 BIND_JOB_SERVICE 权限，否则系统不会调度 -->
        <service
            android:name=".service.AgentJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>

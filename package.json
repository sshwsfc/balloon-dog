{
  "name": "balloon-dog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "气球狗 —— 孩子设备监控（React + TypeScript 前端 / Express + Prisma + PostgreSQL 后端）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:wrap": "node scripts/i18n.mjs --wrap",
    "i18n:wrap-consts": "node scripts/i18n.mjs --wrap-consts",
    "i18n:keys": "node scripts/i18n.mjs --keys",
    "preview": "vite preview",
    "preview:all": "npm run build && concurrently -n server,web -c green,cyan \"npm run server:dev\" \"npm run preview\"",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:smoke": "npm --prefix server run smoke",
    "db:up": "npm --prefix server run db:up",
    "db:down": "npm --prefix server run db:down",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:seed": "npm --prefix server run seed",
    "dev:all": "concurrently -n server,web -c green,cyan \"npm run server:dev\" \"npm run dev -- --host\"",
    "db:clean": "npm --prefix server run clean:test-data",
    "android:build": "cd android && ./gradlew :app:assembleDebug",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "android:e2e": "node android/scripts/e2e-agent.mjs",
    "android:e2e:gaps": "node android/scripts/e2e-gaps.mjs",
    "android:crosstest": "bash android/scripts/crosstest/run.sh",
    "e2e": "node scripts/browser-e2e.mjs",
    "e2e:parent": "node scripts/browser-e2e.mjs --only=parent",
    "e2e:admin": "node scripts/browser-e2e.mjs --only=admin",
    "android:e2e:screen": "node android/scripts/e2e-screen-sampler.mjs",
    "android:capture": "node android/scripts/capture-screens.mjs",
    "server:mock:ai": "node server/scripts/mock-ai-server.mjs",
    "server:e2e:insights": "node server/scripts/e2e-screen-insights.mjs",
    "server:e2e:ai": "node server/scripts/e2e-ai-analysis.mjs",
    "server:e2e:mode": "node server/scripts/e2e-mode.mjs",
    "server:e2e:icons": "node server/scripts/e2e-app-icons.mjs",
    "server:e2e:health": "node server/scripts/e2e-health.mjs",
    "server:e2e:notifications": "node server/scripts/e2e-notifications.mjs",
    "server:e2e:time-requests": "node server/scripts/e2e-time-requests.mjs",
    "server:e2e:child-home": "node server/scripts/e2e-child-home.mjs",
    "server:e2e:device-members": "node server/scripts/e2e-device-members.mjs",
    "server:e2e:children": "node server/scripts/e2e-children.mjs",
    "server:e2e:privacy": "node server/scripts/e2e-privacy.mjs",
    "server:e2e:payments": "node server/scripts/e2e-payments.mjs",
    "server:e2e:flags": "node server/scripts/e2e-flags.mjs",
    "server:e2e:tickets": "node server/scripts/e2e-tickets.mjs",
    "server:e2e:alerts": "node server/scripts/e2e-alerts.mjs",
    "server:e2e:wechat": "node server/scripts/e2e-wechat.mjs",
    "server:e2e:membership": "node server/scripts/e2e-membership.mjs",
    "server:e2e:referral": "node server/scripts/e2e-referral.mjs",
    "android:e2e:mode": "node android/scripts/e2e-mode.mjs",
    "e2e:responsive": "node scripts/browser-e2e.mjs --only=responsive",
    "e2e:ux": "node scripts/browser-e2e.mjs --only=ux",
    "deploy": "node scripts/deploy.mjs",
    "deploy:rollback": "node scripts/deploy.mjs --rollback",
    "smoke:live": "node scripts/smoke-deployed.mjs",
    "e2e:all": "node scripts/e2e-matrix.mjs",
    "e2e:matrix": "node scripts/e2e-matrix.mjs",
    "e2e:matrix:ci": "node scripts/e2e-matrix.mjs --only=static,contract,ui",
    "e2e:matrix:list": "node scripts/e2e-matrix.mjs --list",
    "e2e:device:matrix": "node scripts/e2e-matrix.mjs --only=matrix --boot",
    "android:copy-apk": "node -e \"require('fs').copyFileSync('android/app/build/outputs/apk/release/app-release.apk','public/download/balloon-dog-agent.apk')\"",
    "check:payment-keys": "npm --prefix server run check:payment-keys --"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@kesi/deploy": "file:../deploy",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}

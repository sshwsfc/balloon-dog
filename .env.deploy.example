# 部署配置模板：复制为 .env.deploy 后填写（.env.deploy 已被 gitignore，不会入库）
# 也可以不建文件，直接用环境变量覆盖，例如：DEPLOY_HOST=1.2.3.4 npm run deploy

# 服务器地址（IP 或域名）
DEPLOY_HOST=1.2.3.4
# SSH 用户名
DEPLOY_USER=root
# 对外域名（必须与仓库根 .env 的 VITE_SERVER_URL 一致，脚本会校验）
DEPLOY_DOMAIN=bdog.gtsiot.cn
# 远程根目录（不含 ..）；结构固定为 releases/<tag> + current 软链 + uploads/pgdata/backup
DEPLOY_ROOT=/opt/app/bdog

# 以下为可选项
# SSH 端口，默认 22
DEPLOY_PORT=22
# 私钥文件路径（等同 ssh -i），留空则用 ssh 默认密钥/agent
DEPLOY_KEY=~/.ssh/id_ed25519
# 目标目录属主不是登录用户、需要 sudo 才能写入时设为 1（当前 root 登录用不到）
DEPLOY_SUDO=0
